# Local demonstration defaults. Copy to .env and change ports/secrets as needed.
POSTGRES_USER=itms_admin
POSTGRES_PASSWORD=itms123456
POSTGRES_DB=itms_bd
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost
BACKEND_PORT=8080
FRONTEND_PORT=3000
JWT_SECRET=ITMS-BD-DevSecret-Change-Me-At-Least-32-Bytes
ITMS_DEMO_ENABLED=true
ITMS_DEMO_RESET_DEFAULT_USERS=false
ITMS_MIGRATE_LEGACY_PASSWORDS=true
ITMS_TRAFFIC_SIMULATOR_ENABLED=true
ITMS_HTTP_THREADS=64
ITMS_MAX_IN_FLIGHT=24
ITMS_DB_POOL_SIZE=20
ITMS_KAFKA_PARTITIONS=1
ITMS_KAFKA_REPLICAS=1
ITMS_KAFKA_CONCURRENCY=1
ITMS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
